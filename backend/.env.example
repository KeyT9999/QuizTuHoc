# ==============================================================================
# QUIZTUHOC BACKEND — ENVIRONMENT VARIABLES
# Copy file này thành .env rồi điền giá trị thực tế
# ==============================================================================

NODE_ENV=development
PORT=4000

# Số proxy đứng trước Express (1 khi chạy sau Nginx/Caddy trên VPS)
TRUST_PROXY=1

# MongoDB Connection URI
# Local / Docker VPS: mongodb://127.0.0.1:27017/quiztuhoc
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/quiztuhoc?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/quiztuhoc

# JWT Secret (tạo chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: openssl rand -hex 32)
JWT_SECRET=thay_bang_chuoi_bi_mat_ngau_nhien_it_nhat_32_ky_tu
JWT_EXPIRES_IN=30d

# Google OAuth 2.0 Credentials (lấy từ https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI phải khớp chính xác GOOGLE_CALLBACK_URL bên dưới
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# URL chính của Frontend (dùng để redirect sau khi đăng nhập Google)
FRONTEND_URL=http://localhost:5173

# Danh sách các origin được phép gọi CORS (phân tách bằng dấu phẩy)
# Ví dụ production: https://quiz-tu-hoc.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Tùy chọn: đặt domain cho HttpOnly cookie nếu frontend và backend chung domain (vd: .yourdomain.com)
COOKIE_DOMAIN=

# Danh sách email được tự động cấp quyền Admin (phân tách bằng dấu phẩy)
ADMIN_EMAILS=admin@example.com
